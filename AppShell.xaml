<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ShipInfo.Pages"
       x:Class="ShipInfo.AppShell"
       Shell.BackgroundColor="#3590DC" Shell.TitleColor="White" Shell.ForegroundColor="White"
       Shell.TabBarBackgroundColor="#3590DC" Shell.TabBarTitleColor="White"
       Shell.TabBarUnselectedColor="#0B2A66" Shell.TabBarForegroundColor="White">
  <TabBar>
    <ShellContent Title="Мой флот" ContentTemplate="{DataTemplate pages:FleetPage}" Route="fleet"/>
    <ShellContent Title="Поиск" ContentTemplate="{DataTemplate pages:SearchPage}" Route="search"/>
    <ShellContent Title="Карта" ContentTemplate="{DataTemplate pages:MapPage}" Route="map"/>
    <ShellContent Title="Отзывы" ContentTemplate="{DataTemplate pages:ReviewsPage}" Route="reviews"/>
    <ShellContent Title="Новости" ContentTemplate="{DataTemplate pages:NewsPage}" Route="news"/>
  </TabBar>
</Shell>
