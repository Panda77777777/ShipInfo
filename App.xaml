<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShipInfo.App">
  <Application.Resources>
    <Color x:Key="Primary">#3590DC</Color>
    <DataTemplate x:Key="ShipTemplate">
      <Border Stroke="#3590DC" StrokeThickness="2" Margin="12,6" Padding="12" StrokeShape="RoundRectangle 12">
        <Grid ColumnDefinitions="70,*" ColumnSpacing="12">
          <Label Text="🚢" FontSize="42" VerticalOptions="Center" HorizontalOptions="Center"/>
          <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label Text="{Binding Name}" FontSize="20" TextColor="#2A1AA8"/>
            <Label Text="{Binding Names}" FontSize="13" TextColor="#0B6B3A"/>
            <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
              <Label Text="{Binding Imo}" TextColor="#F57C00" FontSize="18"/>
              <Label Text="{Binding Type}" FontSize="18"/>
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </Grid>
      </Border>
    </DataTemplate>
  </Application.Resources>
</Application>
