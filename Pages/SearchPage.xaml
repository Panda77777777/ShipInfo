<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShipInfo.Pages.SearchPage" Title="Поиск">
  <Grid RowDefinitions="Auto,*">
    <SearchBar x:Name="Bar" Placeholder="IMO номер, название судна, MMSI" TextChanged="OnText"/>
    <CollectionView x:Name="List" Grid.Row="1" ItemTemplate="{StaticResource ShipTemplate}"
                    SelectionMode="Single" SelectionChanged="OnSelected"/>
  </Grid>
</ContentPage>
