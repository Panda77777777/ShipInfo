<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShipInfo.Pages.NewsPage" Title="Новости">
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="Источники" Clicked="OnSources"/>
  </ContentPage.ToolbarItems>
  <CollectionView x:Name="List">
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Border Stroke="#3590DC" StrokeThickness="2" Margin="12,6" Padding="12" StrokeShape="RoundRectangle 12">
          <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold" TextColor="#2A1AA8"/>
            <Label Text="{Binding Text}"/>
            <Label Text="{Binding Date}" FontAttributes="Italic" TextColor="#0B6B3A"/>
            <Label Text="{Binding Source}" FontSize="12" TextColor="Gray"/>
          </VerticalStackLayout>
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
