<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShipInfo.Pages.ShipDetailPage" Title="Судно">
  <VerticalStackLayout Padding="20" Spacing="8">
    <Label x:Name="NameL" FontSize="28" TextColor="#2A1AA8"/>
    <Label x:Name="NamesL" TextColor="#0B6B3A"/>
    <Label x:Name="ImoL" FontSize="18" TextColor="#F57C00"/>
    <Label x:Name="TypeL" FontSize="18"/>
    <Label x:Name="FlagL" FontSize="18"/>
    <Label x:Name="PosL" FontSize="16"/>
    <Button x:Name="FavBtn" Clicked="OnFav" Margin="0,16,0,0"/>
  </VerticalStackLayout>
</ContentPage>
